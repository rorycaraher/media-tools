#!/usr/bin/env bash
# Cut clips from a video using a text file of "start end [label]" lines.
set -euo pipefail

usage() {
  echo "Usage: vidclips [--copy] [--4x5] <video file> <timestamps.txt>" >&2
  exit 1
}

copy=0
fourfive=0
args=()
for a in "$@"; do
  case "$a" in
    --copy) copy=1 ;;
    --4x5) fourfive=1 ;;
    *) args+=("$a") ;;
  esac
done

[[ ${#args[@]} -eq 2 ]] || usage
input="${args[0]}"
stamps="${args[1]}"

if [[ $copy -eq 1 && $fourfive -eq 1 ]]; then
  echo "vidclips: --copy and --4x5 cannot be combined (resizing needs a re-encode)" >&2
  exit 1
fi
[[ -f "$input" ]] || { echo "vidclips: no such file: $input" >&2; exit 1; }
[[ -f "$stamps" ]] || { echo "vidclips: no such file: $stamps" >&2; exit 1; }

base="$(basename "${input%.*}")"
outdir="$(dirname "$input")/${base}_clips"

time_re='^([0-9]+:){0,2}[0-9]+(\.[0-9]+)?$'

to_seconds() {
  awk -v t="$1" 'BEGIN { n = split(t, p, ":"); s = 0; for (i = 1; i <= n; i++) s = s * 60 + p[i]; print s }'
}

# Pass 1: validate every line before encoding anything.
lines=()
starts=()
ends=()
names=()
seen=""
while IFS= read -r line || [[ -n "$line" ]]; do
  lineno=$((${lineno:-0} + 1))
  line="${line%$'\r'}"
  read -r start end label <<<"$line" || true
  [[ -z "$start" || "$start" == \#* ]] && continue

  if [[ -z "$end" ]]; then
    echo "vidclips: line $lineno: expected 'start end [label]'" >&2
    exit 1
  fi
  for t in "$start" "$end"; do
    if ! [[ "$t" =~ $time_re ]]; then
      echo "vidclips: line $lineno: bad timestamp '$t'" >&2
      exit 1
    fi
  done
  if ! awk -v a="$(to_seconds "$start")" -v b="$(to_seconds "$end")" 'BEGIN { exit !(a < b) }'; then
    echo "vidclips: line $lineno: start must be before end" >&2
    exit 1
  fi

  label="$(printf '%s' "$label" | tr '/:\\*?"<>|' '_')"
  if [[ -n "$label" ]]; then
    name="$label"
  else
    name="$(printf '%s_%02d' "$base" "$lineno")"
  fi
  if printf '%s\n' "$seen" | grep -Fxq -- "$name"; then
    echo "vidclips: line $lineno: duplicate clip name '$name'" >&2
    exit 1
  fi
  seen+="$name"$'\n'

  lines+=("$lineno")
  starts+=("$start")
  ends+=("$end")
  names+=("$name")
done <"$stamps"

total=${#names[@]}
if [[ $total -eq 0 ]]; then
  echo "vidclips: no clips found in $stamps" >&2
  exit 1
fi

mkdir -p "$outdir"

vf='[0:v:0]split=2[bg][fg];[bg]scale=1080:1350:force_original_aspect_ratio=increase,crop=1080:1350,boxblur=20:5[b];[fg]scale=1080:1350:force_original_aspect_ratio=decrease[f];[b][f]overlay=(W-w)/2:(H-h)/2,setsar=1[v]'

partial=""
trap '[[ -n "$partial" ]] && rm -f "$partial"' EXIT

for i in "${!names[@]}"; do
  start="${starts[$i]}"
  end="${ends[$i]}"
  out="$outdir/${names[$i]}.mp4"
  n=$((i + 1))

  if [[ -e "$out" ]]; then
    echo "[$n/$total] skipping ${names[$i]} (exists)" >&2
    continue
  fi

  tag=""
  [[ $fourfive -eq 1 ]] && tag=" 4:5"
  echo "[$n/$total] ${names[$i]} ($start → $end)$tag" >&2

  if [[ $copy -eq 1 ]]; then
    codec=(-map 0:v:0 -map '0:a:0?' -c copy -avoid_negative_ts make_zero)
  elif [[ $fourfive -eq 1 ]]; then
    codec=(-filter_complex "$vf" -map '[v]' -map '0:a:0?' -c:v libx264 -crf 18 -preset medium -c:a aac -b:a 192k)
  else
    codec=(-map 0:v:0 -map '0:a:0?' -c:v libx264 -crf 18 -preset medium -c:a aac -b:a 192k)
  fi

  partial="$out"
  if ! ffmpeg -loglevel error -stats -ss "$start" -to "$end" -i "$input" \
      "${codec[@]}" -movflags +faststart "$out" </dev/null; then
    echo "vidclips: ffmpeg failed on line ${lines[$i]} (${names[$i]})" >&2
    exit 1
  fi
  partial=""
done

echo "Done: $outdir"
