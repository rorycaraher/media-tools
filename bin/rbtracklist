#!/usr/bin/env python3
"""Reformat a UTF-16LE tab-separated tracklist (# Artist Track Title Label).

Writes two UTF-8 files next to the input:
  <name>_label.txt    "Artist - Track Title [Label]"
  <name>_nolabel.txt  "Artist - Track Title"
"""
import sys
from pathlib import Path


def main():
    if len(sys.argv) != 2:
        print("Usage: tracklist <tracklist.txt>", file=sys.stderr)
        return 1

    src = Path(sys.argv[1])
    text = src.read_text(encoding="utf-16-le").lstrip("﻿")

    with_label, without_label = [], []
    for line in text.splitlines():
        cols = line.split("\t")
        if len(cols) < 3 or not cols[0].strip().isdigit():
            continue  # header or blank line
        artist, title = cols[1].strip(), cols[2].strip()
        label = cols[3].strip() if len(cols) > 3 else ""
        base = f"{artist} - {title}"
        without_label.append(base)
        with_label.append(f"{base} [{label}]" if label else base)

    out_label = src.with_name(f"{src.stem}_label.txt")
    out_nolabel = src.with_name(f"{src.stem}_nolabel.txt")
    out_label.write_text("\n".join(with_label) + "\n", encoding="utf-8")
    out_nolabel.write_text("\n".join(without_label) + "\n", encoding="utf-8")

    print(f"Done: {out_label}")
    print(f"Done: {out_nolabel}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
