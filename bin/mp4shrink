#!/usr/bin/env bash
# Re-encode a video to H.264 at a smaller height and CRF.
set -euo pipefail

if [[ -z "${1:-}" ]]; then
  echo "Usage: mp4shrink <input.mp4> [output.mp4] [crf] [height]" >&2
  exit 1
fi

input="$1"
output="${2:-${input%.*}_compressed.mp4}"
crf="${3:-28}"
height="${4:-720}"

ffmpeg -i "$input" -vf "scale=-2:${height}" -c:v libx264 -crf "$crf" -preset slow -c:a aac -b:a 320k "$output"

echo "Done: $output"
